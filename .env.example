# Public website configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_VERIFIED=false
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Local SQLite development database. For Turso, leave this blank and set both
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN instead.
DATABASE_URL=file:./data/bsb-global.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_ENQUIRY_API_ENABLED=false

# Admin access. Use a unique, long password and a random 32+ character session secret.
# Example secret generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
