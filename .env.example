# Your live HTTPS domain WITHOUT a trailing slash, e.g. https://bsbglobalvictory.com
# On Vercel this can stay empty: the Vercel production URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Search-engine indexing is ON once a public URL is known. Set to false to hide the site from search engines.
NEXT_PUBLIC_SITE_VERIFIED=

# Company name, emails and phone numbers live in src/lib/site-config.ts.
# Optional public details; do not put secrets here.
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WHATSAPP_NUMBER=
